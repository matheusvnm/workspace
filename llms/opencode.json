{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git", "opencode-claude-auth@latest"],
  "permission": {
    "bash": {
      "*": "ask",
      "gh api * -X *": "ask",
      "sentry api * -X *": "ask",
      "head *" : "allow",
      "true *": "allow",
      "tail *" : "allow",
      "sort *" : "allow",
      "find *" : "allow",
      "tree *" : "allow",
      "uniq *" : "allow",
      "rg *" : "allow",
      "base64 *" : "allow",
      "command *" : "allow",
      "grep *" : "allow",
      "pwd w" : "allow",
      "awk *" : "allow",
      "cat *" : "allow",
      "echo *": "allow",
      "ls *": "allow",
      "which *": "allow",
      "where *": "allow",
      "whoami *": "allow",
      "groups *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "xargs *": "allow",
      "* --help *": "allow",
      "node *": "allow",
      "bun *": "allow",
      "eslint *": "allow",
      "biome *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "uv *": "allow",
      "acli * view *": "allow",
      "acli * search *": "allow",
      "acli * list *": "allow",
      "git branch *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git merge-base *":"allow",
      "git status *":"allow",
      "git show *":"allow",
      "git remote -v *": "allow",
      "git ls-tree *": "allow",
      "git rev-parse *": "allow",
      "git stash *": "allow",
      "git mv *": "allow",
      "gh * status *": "allow",
      "gh * view *": "allow",
      "gh * diff *": "allow",
      "gh * list *": "allow",
      "gh pr create *": "allow",
      "gh pr edit *": "allow",
      "gh api *": "allow",
      "sentry api *": "allow",
      "sentry * view *": "allow",
      "jq *": "allow",
      "docker *": "allow",
      "just *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "gh workflow run deploy-feature.yml *": "allow",
      "gh workflow run cleanup-feature.yml *": "allow",
      "swift *": "allow",
      "xcrun *": "allow",
      "xcodebuild *": "allow",
    }
  }
}
