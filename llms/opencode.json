{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git", "opencode-claude-auth"],
  "permission": {
    "bash": {
      /* Ask-first Integrations */
      "*": "ask",
      "gh api * -X *": "ask",
      "sentry api * -X *": "ask",

      /* Allowed Integrations */
      /* Bash Tools */
      "head *" : "allow",
      "true *": "allow",
      "tail *" : "allow",
      "sort *" : "allow",
      "find *" : "allow",
      "tree *" : "allow",
      "rg *" : "allow",
      "base64 *" : "allow",
      "command *" : "allow",
      "grep *" : "allow",
      "awk *" : "allow",
      "cat *" : "allow",
      "echo *": "allow",
      "ls *": "allow",
      "which *": "allow",
      "where *": "allow",
      "whoami *": "allow",
      "groups *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "xargs *": "allow",
      "* --help": "allow",

      /* Typescript Tools */
      "node *": "allow",
      "bun *": "allow",
      "eslint *": "allow",
      "biome *": "allow",

      /* Python Tools */
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "uv *": "allow",

      /* Jira CLI */
      "acli * view *": "allow",
      "acli * search *": "allow",
      "acli * list *": "allow",

      /* Git CLI */
      "git branch *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git merge-base *":"allow",
      "git status *":"allow",
      "git show *":"allow",
      "git remote -v *": "allow",
      "git ls-tree *": "allow",
      "git rev-parse *": "allow",
      "git stash *": "allow",

      /* Github CLI */
      "gh * status *": "allow",
      "gh * view *": "allow",
      "gh * diff *": "allow",
      "gh * list *": "allow",
      "gh api *": "allow",

      /* Sentry CLI */
      "sentry api *": "allow",
      "sentry * view *": "allow",

      /* CLI Misc */
      "jq *": "allow",
      "docker *": "allow",
      "just *": "allow",
    }
  }
}
